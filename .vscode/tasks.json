{
  // Ctrl+Shift+B no VS Code roda o analisador numa janela propria do Windows
  // (o mesmo que dar duplo clique no .bat pelo Explorador de Arquivos); o terminal do VS Code nao aparece
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Analisar videos",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-Command", "Start-Process -FilePath 'ANALISAR VIDEOS.bat'"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "never", "panel": "dedicated", "focus": false, "close": true },
      "problemMatcher": []
    }
  ]
}
